# VoltRoute Environment Variables
# Copy this file to .env.local and update the values

# JWT secret for authentication tokens (change this in production!)
JWT_SECRET=voltroute-dev-secret-change-in-production

# Optional: Google Maps API key for map features
# Get one at https://console.cloud.google.com/google/maps-apis
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key-here

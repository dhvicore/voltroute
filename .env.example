# Database file must live on a persistent writable disk.
DB_PATH=./voltroute.db

# Optional: set a long random secret in production.
# If omitted, a random secret is generated and persisted in the database.
# JWT_SECRET=

# Optional provider endpoints; public services are suitable for light development use.
# Use hosted or self-hosted providers for production traffic.
GEOCODING_URL=https://photon.komoot.io/api/
ROUTING_URL=https://router.project-osrm.org

# Optional: comma-separated Overpass servers for charging stations from OpenStreetMap.
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Recommended: free key from https://openchargemap.org (My Profile > My Apps) for India-wide charger coverage.
# OPENCHARGEMAP_KEY=

# Google Maps Platform (recommended for real routes, live traffic and real EV stations).
# Server key: enable "Routes API" and "Places API (New)". Keep it secret.
# GOOGLE_MAPS_API_KEY=
# Browser key for drawing the map: enable "Maps JavaScript API" and restrict it to your site's domain.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Free live-traffic routing (no card): https://developer.tomtom.com
# TOMTOM_API_KEY=
